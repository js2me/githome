{
  "name": "githome",
  "private": true,
  "version": "0.1.0",
  "description": "GitHome desktop client for GitLab",
  "author": {
    "name": "js2me",
    "email": "js2me@users.noreply.github.com"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "desktopName": "githome",
  "scripts": {
    "dev": "vite",
    "dev:electron": "cross-env ELECTRON=1 vite",
    "build": "cross-env WEB_ONLY=1 tsc && cross-env WEB_ONLY=1 vite build",
    "build:app": "cross-env ELECTRON=1 tsc && tsc -p tsconfig.node.json && cross-env ELECTRON=1 vite build",
    "package:linux": "electron-builder --publish never --linux",
    "package:win": "electron-builder --publish never --win",
    "package:mac": "electron-builder --publish never --mac",
    "build:electron": "pnpm build:app && electron-builder --publish never",
    "build:full": "pnpm build:app && electron-builder --publish never --linux --win --mac",
    "build:android": "pnpm build && cap sync android && cd android && ./gradlew assembleDebug",
    "build:android:release": "pnpm build && cap sync android && cd android && ./gradlew assembleRelease",
    "preview": "vite preview",
    "lint:check": "biome check src",
    "lint:fix": "biome check --write src",
    "test": "vitest run",
    "check:browser": "node scripts/browser-check.mjs",
    "postinstall": "node node_modules/electron/install.js",
    "link:debug:packages": "npx --yes packalink"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@gravity-ui/icons": "^2.18.0",
    "@shikijs/langs": "^4.2.0",
    "@tanstack/query-core": "^5.101.0",
    "@tanstack/react-virtual": "^3.14.3",
    "diff": "^9.0.0",
    "dompurify": "3.5.0",
    "echarts": "^6.1.0",
    "electron-updater": "^6.8.11",
    "gologen": "0.0.1",
    "i18next": "^27.2.9",
    "mobx": "^7.1.7",
    "mobx-location-history": "^9.5.1",
    "mobx-react-lite": "^5.1.4",
    "mobx-route": "^2.2.0",
    "mobx-tanstack-query": "^8.0.0",
    "mobx-view-model": "^11.1.0",
    "mobx-view-model-react": "^11.1.0",
    "mobx-web-api": "^1.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.2.0",
    "yummies": "^7.23.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "js2me-biome-config": "1.1.0",
    "material-icon-theme": "5.40.0",
    "mobx-view-model-vite-plugin": "^2.0.7",
    "puppeteer-core": "^25.4.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-static-copy": "3.1.6",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  },
  "build": {
    "appId": "com.js2me.githome",
    "productName": "GitHome",
    "publish": {
      "provider": "github",
      "owner": "js2me",
      "repo": "githome"
    },
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "linux": {
      "extraResources": [
        {
          "from": "resources/icon.png",
          "to": "icon.png"
        }
      ],
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Development",
      "executableName": "githome",
      "synopsis": "GitHome desktop client for GitLab",
      "description": "Desktop client for GitLab merge requests and code review."
    },
    "deb": {
      "packageName": "git-home",
      "mimeTypes": [
        "x-scheme-handler/https"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "protocols": [
        {
          "name": "Web links",
          "schemes": [
            "http",
            "https"
          ],
          "role": "Viewer"
        }
      ],
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "HTML document",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.html"
            ]
          }
        ]
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
