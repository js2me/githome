{
  "extends": ["js2me-biome-config/base.json"],
  "linter": {
    "rules": {
      "nursery": {
        "noFloatingPromises": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "warn"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "react": {
                "importNames": ["useRef", "useState", "useEffect"],
                "message": "Храните состояние, DOM-ссылки и эффекты в VM."
              }
            }
          }
        }
      }
    }
  }
}
